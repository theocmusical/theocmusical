---
import Layout from '../layouts/Layout.astro';

const firehallUrl = (slug: string) =>
  `http://tickets.vancouverfringe.com/events/the%20o_c_-%20the%20musical/${slug}/firehall%20arts%20centre?back=2&area=731a7b6a-17ef-4ff8-9e3f-0121c64f4597&type=ga`;

const firehallShows = [
  [
    { label: 'Fri. Sep. 11 @ 10:15pm', slug: '2015-9-11_22.15', soldOut: true },
    { label: 'Sat. Sep. 12 @ 3:15pm', slug: '2015-9-12_15.15', soldOut: false },
    { label: 'Sun. Sep. 13 @ 7:45pm', slug: '2015-9-13_19.45', soldOut: false },
    { label: 'Mon. Sep. 14 @ 6:45pm', slug: '2015-9-14_18.45', soldOut: true },
  ],
  [
    { label: 'Wed. Sep. 16 @ 5:00pm', slug: '2015-9-16_17.00', soldOut: false },
    { label: 'Fri. Sep. 18 @ 9:00pm', slug: '2015-9-18_21.00', soldOut: true },
    { label: 'Sat. Sep. 19 @ 3:45pm', slug: '2015-9-19_15.45', soldOut: true },
    { label: 'Sun. Sep. 20 @ 8:30pm', slug: '2015-9-20_20.30', soldOut: true },
  ],
];

const quotes = [
  {
    text: 'is 90 minutes of hilarious, ridiculous parody that will keep you entertained from the moment you sit down in your seat. The standout star is by far Mark Dozlaw, who plays Seth Cohen. Dozlaw steps into the shoes of simultaneously adorable and nerdy Seth Cohen with gusto and charm.',
    titleFirst: true,
    source: 'Vancity Buzz',
    url: 'http://www.vancitybuzz.com/2015/09/the-o-c-musical-just-parody/',
  },
  {
    text: 'Joey Coleman stole the show with his spot-on Ryan Atwood impression, which came complete with a black choker, trailer park-chic beater and a preening bad boy allure. Stewart Yu delivered a magnetic performance by playing Julie Cooper as a dazzling drag queen, while Brandon Miller displayed comically oversized eyebrows and a just-one-of-the-boys attitude with his amusing Sandy Cohen.',
    source: 'Beat Route Magazine',
    url: 'http://beatroute.ca/2015/09/16/review-the-o-c-the-musical/',
  },
  {
    text: 'It was clear to me right from the start there was a lot of love put into this project.  The cast were having so much FUN on stage, how could we not have a blast as well in the audience?',
    source: 'Plank Magazine',
    url: 'http://www.plankmagazine.com/review/oc-musical-so-many-feelings',
  },
];
---

<Layout title="The O.C. The Musical" template="home">
  <h3>Watch the show</h3>

  <div class="embed-container">
    <iframe
      src="https://www.youtube.com/embed/IBl-Bgg6yQs"
      title="The O.C.: The Musical"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen></iframe>
  </div>

  <div class="columns center">
    <ul class="columns_column">
      <li>Music and Lyrics: Stewart Yu</li>
      <li>Book: Angela Wong</li>
    </ul>
    <ul class="columns_column">
      <li>Director/Choreographer: Dawn Ewen</li>
      <li>Music Director: Stewart Yu</li>
    </ul>
  </div>

  <hr />

  <h3>About</h3>

  <p>
    <em>The O.C.: The Musical</em> premiered at the Vancouver Fringe Festival, running from Sep. 11-20, 2015. Written by the creators of <em>Riverview High</em>, winner of the 2012 Pick of the Fringe in Vancouver, <em>The O.C.: The Musical</em> parodies the popular TV teen drama series, <em>The O.C.</em>, in an over-the-top, unauthorized retelling of the primetime hit. <br /> <br />
  </p>

  <hr />

  <h3>Critical acclaim</h3>

  {
    quotes.map((q) => (
      <blockquote class="quote">
        "{q.titleFirst && <><em>The O.C.: The Musical</em> </>}{q.text}" <a href={q.url}>{q.source}</a>
      </blockquote>
    ))
  }

  <hr />

  <div class="disabled_block">
    <h3>Pick of the Fringe!</h3>

    <p>
      Due to popular demand, <em>The O.C.: The Musical</em> is back for one encore performance as part of the 2015 Pick Of
      The Fringe!
    </p>

    <div class="tickets columns center">
      Thu. Sep. 24 @ 6:45pm <a
        href="http://tickets.vancouverfringe.com/events/pick%20of%20the%20fringe%20presents-%20the%20o_c_-%20the%20musical/2015-9-24_18.45/revue%20stage?back=2&area=e8078adc-80f2-4f77-b285-cb5911cf1224&type=ga"
        class="button">Buy Tickets</a
      >
    </div>

    <strong>The Revue Stage</strong>: <a
      href="https://www.google.ca/maps/place/1585+Johnston+St,+Vancouver,+BC+V6H+3R9/@49.2720281,-123.1347093,17z/data=!3m1!4b1!4m2!3m1!1s0x548673ce6ec8ce05:0x7343084e132bd23b"
      >1585 Johnston Street</a
    >, Granville Island, Vancouver, BC
    <br /><br />
  </div>

  <hr />

  <div class="disabled_block">
    <h3>See the show</h3>

    <div class="tickets columns center">
      {
        firehallShows.map((column) => (
          <ul class="columns_column">
            {column.map((show) => (
              <li>
                {show.label}{' '}
                <a href={firehallUrl(show.slug)} class:list={['button', { soldout: show.soldOut }]}>
                  {show.soldOut ? 'SOLD OUT!!' : 'Buy Tickets'}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>

    <strong>Firehall Arts Centre</strong>: <a
      href="https://www.google.ca/maps/place/280+E+Cordova+St,+Vancouver,+BC+V6A/@49.2822489,-123.0977076,17z/data=!3m1!4b1!4m2!3m1!1s0x5486717105cbd765:0xfb934f6994380167"
      >280 E. Cordova Street</a
    >, Vancouver, BC
    <br /><br />
  </div>

  <hr />

  <h3>Hear a sneak peek</h3>

  <iframe
    width="100%"
    height="450"
    scrolling="no"
    frameborder="no"
    title="The O.C.: The Musical on SoundCloud"
    src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/195526141&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&visual=true"
  ></iframe>

  <hr />

  <h3>Stay in the loop</h3>

  <div id="mc_embed_signup">
    <form
      action="https://appilywed.us5.list-manage.com/subscribe/post?u=e1a70947ab1800d0d8803e3a5&id=7e57910809"
      method="post"
      id="mc-embedded-subscribe-form"
      name="mc-embedded-subscribe-form"
      class="validate"
      target="_blank"
      novalidate
    >
      <div id="mc_embed_signup_scroll" class="signup">
        <div class="mc-field-group">
          <label for="mce-EMAIL"><span class="asterisk"></span></label>
          <input type="email" value="" name="EMAIL" class="required email" id="mce-EMAIL" placeholder="Email Address" />
        </div>
        <div id="mce-responses" class="clear">
          <div class="response" id="mce-error-response" style="display:none"></div>
          <div class="response" id="mce-success-response" style="display:none"></div>
        </div>
        <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups-->
        <div style="position: absolute; left: -5000px;" aria-hidden="true">
          <input type="text" name="b_e1a70947ab1800d0d8803e3a5_7e57910809" tabindex="-1" value="" />
        </div>
        <div class="clear">
          <input type="submit" value="Sign me up!" name="subscribe" id="mc-embedded-subscribe" class="button" />
        </div>
      </div>
    </form>
  </div>
  <script is:inline src="https://s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js"></script>
  <script is:inline>
    (function ($) {
      window.fnames = new Array();
      window.ftypes = new Array();
      fnames[0] = 'EMAIL';
      ftypes[0] = 'email';
      fnames[1] = 'FNAME';
      ftypes[1] = 'text';
      fnames[2] = 'LNAME';
      ftypes[2] = 'text';
    })(jQuery);
    var $mcj = jQuery.noConflict(true);
  </script>
</Layout>
